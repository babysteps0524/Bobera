---
import AppLayout from '../../layouts/AppLayout.astro';
---

<AppLayout title="납품 내역" currentPath="/deliveries">
  <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">납품 내역</h1>
      <p class="text-sm text-gray-500 mt-1">보베라 지역주택조합으로 납품한 모든 광고 물품을 기록합니다.</p>
    </div>
    <button
      id="add-delivery-btn"
      class="inline-flex items-center gap-2 px-4 py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-medium transition-colors shadow-sm"
    >
      <i class="i-ph:plus text-sm"></i>
      <span>납품 등록</span>
    </button>
  </div>

  <!-- 요약 카드 -->
  <div class="grid grid-cols-1 gap-3 md:grid-cols-2 lg:grid-cols-4 mb-6">
    <div class="bg-white p-4 rounded-xl border border-gray-200 shadow-sm">
      <p class="text-xs font-semibold text-gray-400 uppercase">총 납품 건수</p>
      <p id="stat-count" class="text-lg font-bold text-gray-900 mt-1">0</p>
    </div>
    <div class="bg-white p-4 rounded-xl border border-gray-200 shadow-sm">
      <p class="text-xs font-semibold text-gray-400 uppercase">총 납품 수량</p>
      <p id="stat-quantity" class="text-lg font-bold text-gray-900 mt-1">0</p>
    </div>
    <div class="bg-white p-4 rounded-xl border border-gray-200 shadow-sm">
      <p class="text-xs font-semibold text-gray-400 uppercase">총원가 합계</p>
      <p id="stat-cost" class="text-lg font-bold text-gray-900 mt-1">0 원</p>
    </div>
    <div class="bg-white p-4 rounded-xl border border-gray-200 shadow-sm">
      <p class="text-xs font-semibold text-gray-400 uppercase">총 배송료 합계</p>
      <p id="stat-fee" class="text-lg font-bold text-gray-900 mt-1">0 원</p>
    </div>
    <div class="bg-white p-4 rounded-xl border border-gray-200 shadow-sm">
      <p class="text-xs font-semibold text-gray-400 uppercase">총 납품금액</p>
      <p id="stat-sale" class="text-lg font-bold text-gray-900 mt-1">0 원</p>
    </div>
    <div class="bg-white p-4 rounded-xl border border-gray-200 shadow-sm">
      <p class="text-xs font-semibold text-gray-400 uppercase">총 마진금액</p>
      <p id="stat-margin" class="text-lg font-bold text-gray-900 mt-1">0 원</p>
    </div>
    <div class="bg-white p-4 rounded-xl border border-gray-200 shadow-sm">
      <p class="text-xs font-semibold text-gray-400 uppercase">가중 평균 마진율</p>
      <p id="stat-margin-rate" class="text-lg font-bold text-gray-900 mt-1">0%</p>
    </div>
  </div>

  <!-- 검색 및 필터 -->
  <div class="bg-white p-6 rounded-xl border border-gray-200 shadow-sm mb-6">
    <div class="grid grid-cols-1 gap-4 md:grid-cols-6">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">키워드 검색</label>
        <input
          id="search-keyword"
          type="text"
          placeholder="물품명, 업체명, 담당자"
          class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-colors"
        />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">물품</label>
        <select id="filter-product" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-colors bg-white">
          <option value="">전체</option>
        </select>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">차수</label>
        <select id="filter-round" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-colors bg-white">
          <option value="">전체</option>
        </select>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">업체</label>
        <select id="filter-vendor" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-colors bg-white">
          <option value="">전체</option>
        </select>
      </div>
      <div class="grid grid-cols-2 gap-2">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">요청일자 시작</label>
          <input id="filter-start-date" type="date" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-colors" />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">요청일자 종료</label>
          <input id="filter-end-date" type="date" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-colors" />
        </div>
      </div>
      <div class="flex items-end col-span-2 md:col-span-1 gap-2">
        <button id="reset-filter-btn" class="px-4 py-2.5 text-gray-600 hover:text-gray-900 hover:bg-gray-100 rounded-lg transition-colors">초기화</button>
        <button id="export-excel-btn" class="px-4 py-2.5 bg-green-600 hover:bg-green-700 text-white rounded-lg font-medium transition-colors shadow-sm text-sm">엑셀 내보내기</button>
      </div>
    </div>
    <div class="md:col-span-2 flex items-end gap-2">
      <label class="text-sm font-medium text-gray-700 mr-2">정렬</label>
      <select id="sort-select" class="px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-colors bg-white">
        <option value="latest">최신순</option>
        <option value="oldest">오래된순</option>
        <option value="amount">금액순 (높은 순)</option>
        <option value="quantity">수량순 (높은 순)</option>
      </select>
    </div>
  </div>

  <!-- 납품 내역 테이블 -->
  <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden mb-6">
    <div class="p-6 border-b border-gray-200">
      <h2 class="text-lg font-bold text-gray-900">납품 목록</h2>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead class="border-b border-gray-200">
          <tr>
            <th class="px-6 py-3 text-xs font-semibold text-gray-400 uppercase">일자</th>
            <th class="px-6 py-3 text-xs font-semibold text-gray-400 uppercase">물품</th>
            <th class="px-6 py-3 text-xs font-semibold text-gray-400 uppercase">차수</th>
            <th class="px-6 py-3 text-xs font-semibold text-gray-400 uppercase">공급 업체</th>
            <th class="px-6 py-3 text-xs font-semibold text-gray-400 uppercase text-center">수량</th>
            <th class="px-6 py-3 text-xs font-semibold text-gray-400 uppercase text-right">개당 원가</th>
            <th class="px-6 py-3 text-xs font-semibold text-gray-400 uppercase text-right">총원가</th>
            <th class="px-6 py-3 text-xs font-semibold text-gray-400 uppercase text-right">배송료</th>
            <th class="px-6 py-3 text-xs font-semibold text-gray-400 uppercase text-right">개당 단가</th>
            <th class="px-6 py-3 text-xs font-semibold text-gray-400 uppercase text-right">총 납품금액</th>
            <th class="px-6 py-3 text-xs font-semibold text-gray-400 uppercase text-right">마진금액</th>
            <th class="px-6 py-3 text-xs font-semibold text-gray-400 uppercase text-center">마진율</th>
            <th class="px-6 py-3 text-xs font-semibold text-gray-400 uppercase text-center">작업</th>
          </tr>
        </thead>
        <tbody id="deliveries-table-body"></tbody>
      </table>
    </div>
    <div id="empty-state" class="p-8 text-center text-gray-400 hidden">
      <p class="text-sm">등록된 납품 내역이 없습니다.</p>
    </div>
  </div>

  <!-- 페이지네이션 -->
  <div class="flex items-center justify-between mt-4">
    <div id="pagination-info" class="text-sm text-gray-600"></div>
    <div id="pagination-controls" class="flex gap-1"></div>
  </div>

  <!-- 납품 내역 추가/수정 모달 -->
  <div
    id="delivery-modal"
    class="fixed inset-0 z-50 hidden"
    aria-hidden="true"
  >
    <div class="fixed inset-0 bg-black/40 backdrop-blur-sm" onclick="closeDeliveryModal()"></div>
    <div class="fixed top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full max-w-2xl bg-white rounded-xl shadow-xl p-6 border border-gray-200 max-h-[90vh] overflow-y-auto">
      <div class="flex items-center justify-between mb-4">
        <h3 id="delivery-modal-title" class="text-lg font-bold text-gray-900">납품 내역 추가</h3>
        <button
          id="close-delivery-modal-btn"
          class="p-2 rounded hover:bg-gray-100 text-gray-600 hover:text-gray-900"
          onclick="closeDeliveryModal()"
          aria-label="모달 닫기"
        >
          <i class="i-ph:x text-lg"></i>
        </button>
      </div>
      <form id="delivery-form" class="space-y-5">
        <input type="hidden" id="delivery-id" />

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">납품 물품 <span class="text-red-500">*</span></label>
            <select id="input-product" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-colors bg-white">
              <option value="">선택하세요</option>
            </select>
            <p id="error-product" class="text-xs text-red-600 mt-1 hidden"></p>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">납품 차수</label>
            <select id="input-round" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-colors bg-white">
              <option value="">선택하세요</option>
            </select>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">공급 업체 <span class="text-red-500">*</span></label>
            <select id="input-vendor" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-colors bg-white">
              <option value="">선택하세요</option>
            </select>
            <p id="error-vendor" class="text-xs text-red-600 mt-1 hidden"></p>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">담당자</label>
            <input id="input-vendor-person" type="text" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-colors" readonly />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">연락처</label>
            <input id="input-vendor-phone" type="text" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-colors" readonly />
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">요청일자 <span class="text-red-500">*</span></label>
            <input id="input-requested-at" type="date" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-colors" />
            <p id="error-requested-at" class="text-xs text-red-600 mt-1 hidden"></p>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">도착일자</label>
            <input id="input-arrived-at" type="date" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-colors" />
            <p id="error-arrived-at" class="text-xs text-red-600 mt-1 hidden"></p>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">수량 <span class="text-red-500">*</span></label>
            <input id="input-quantity" type="number" min="1" required oninput="autoCalculate()" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-colors" />
            <p id="error-quantity" class="text-xs text-red-600 mt-1 hidden"></p>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">개당 원가 (원)</label>
            <input id="input-unit-price" type="number" min="0" oninput="autoCalculate()" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-colors" />
            <p id="error-unit-price" class="text-xs text-red-600 mt-1 hidden"></p>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">배송료 (원)</label>
            <input id="input-delivery-fee" type="number" min="0" value="0" oninput="autoCalculate()" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-colors" />
            <p id="error-delivery-fee" class="text-xs text-red-600 mt-1 hidden"></p>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">개당 단가(판매 단가) (원) <span class="text-red-500">*</span></label>
            <input id="input-unit-sale-price" type="number" min="0" required oninput="autoCalculate()" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-colors" />
            <p id="error-unit-sale-price" class="text-xs text-red-600 mt-1 hidden"></p>
          </div>
          <div class="flex items-end">
            <button type="button" id="calc-preview-btn" class="px-4 py-2 text-gray-600 hover:text-gray-900 hover:bg-gray-100 rounded-lg transition-colors text-sm">계산 미리보기</button>
          </div>
        </div>

        <!-- 계산 결과 미리보기 -->
        <div id="calc-preview" class="bg-blue-50 border border-blue-200 rounded-lg p-4 mt-4 hidden">
          <h4 class="text-sm font-semibold text-blue-800 mb-2">자동 계산 결과</h4>
          <div class="grid grid-cols-2 gap-4 text-sm">
            <div>
              <p class="text-xs text-gray-500">총원가</p>
              <p id="preview-total-cost" class="font-medium text-gray-900">0 원</p>
            </div>
            <div>
              <p class="text-xs text-gray-500">총 납품금액</p>
              <p id="preview-total-sale" class="font-medium text-gray-900">0 원</p>
            </div>
            <div>
              <p class="text-xs text-gray-500">마진금액</p>
              <p id="preview-margin-amount" class="font-medium text-gray-900">0 원</p>
            </div>
            <div>
              <p class="text-xs text-gray-500">마진율</p>
              <p id="preview-margin-rate" class="font-medium text-gray-900">0%</p>
            </div>
          </div>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">비고</label>
          <textarea id="input-note" rows="2" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-colors"></textarea>
        </div>

        <div class="flex justify-end gap-2 pt-4">
          <button type="button" class="px-4 py-2 text-gray-600 hover:text-gray-900 hover:bg-gray-100 rounded-lg transition-colors" onclick="closeDeliveryModal()">취소</button>
          <button type="submit" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-medium transition-colors shadow-sm">저장</button>
        </div>
      </form>
    </div>
  </div>

  <!-- 삭제 확인 모달 -->
  <div
    id="delivery-delete-modal"
    class="fixed inset-0 z-50 hidden"
    aria-hidden="true"
  >
    <div class="fixed inset-0 bg-black/40 backdrop-blur-sm" onclick="closeDeliveryDeleteModal()"></div>
    <div class="fixed top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full max-w-md bg-white rounded-xl shadow-xl p-6 border border-gray-200">
      <h3 class="text-lg font-bold text-gray-900 mb-2">납품 내역 삭제 확인</h3>
      <p class="text-sm text-gray-600 mb-4">
        '<span id="delivery-delete-name" class="font-medium text-gray-900"></span>' 납품 기록을 삭제하시겠습니까?
      </p>
      <div class="flex justify-end gap-2">
        <button type="button" class="px-4 py-2 text-gray-600 hover:text-gray-900 hover:bg-gray-100 rounded-lg transition-colors" onclick="closeDeliveryDeleteModal()">취소</button>
        <button id="confirm-delivery-delete-btn" type="button" class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded-lg font-medium transition-colors shadow-sm">삭제</button>
      </div>
    </div>
  </div>

  <script>
    // @ts-nocheck
    import { DeliveryRepository, ProductRepository, VendorRepository, DeliveryRoundRepository } from '../../services/repositories/index.js';
    import { calculateDeliveryAmounts, formatMoney, formatDate, formatNumber } from '../../lib/calculations/delivery.js';

    const deliveryRepo = new DeliveryRepository();
    const productRepo = new ProductRepository();
    const vendorRepo = new VendorRepository();
    const roundRepo = new DeliveryRoundRepository();

    let deliveries = [];
    let products = [];
    let vendors = [];
    let rounds = [];
    let editingId = null;
    let deleteTargetId = null;
    let currentPage = 1;
    const pageSize = 10;

    const elements = {
      tableBody: document.getElementById('deliveries-table-body'),
      emptyState: document.getElementById('empty-state'),
      modal: document.getElementById('delivery-modal'),
      addBtn: document.getElementById('add-delivery-btn'),
      closeBtn: document.getElementById('close-delivery-modal-btn'),
      form: document.getElementById('delivery-form'),
      title: document.getElementById('delivery-modal-title'),
      idInput: document.getElementById('delivery-id'),
      productSelect: document.getElementById('input-product'),
      roundSelect: document.getElementById('input-round'),
      vendorSelect: document.getElementById('input-vendor'),
      personInput: document.getElementById('input-vendor-person'),
      phoneInput: document.getElementById('input-vendor-phone'),
      requestedAtInput: document.getElementById('input-requested-at'),
      arrivedAtInput: document.getElementById('input-arrived-at'),
      quantityInput: document.getElementById('input-quantity'),
      unitPriceInput: document.getElementById('input-unit-price'),
      deliveryFeeInput: document.getElementById('input-delivery-fee'),
      unitSalePriceInput: document.getElementById('input-unit-sale-price'),
      noteInput: document.getElementById('input-note'),
      calcPreview: document.getElementById('calc-preview'),
      previewTotalCost: document.getElementById('preview-total-cost'),
      previewTotalSale: document.getElementById('preview-total-sale'),
      previewMarginAmount: document.getElementById('preview-margin-amount'),
      previewMarginRate: document.getElementById('preview-margin-rate'),
      searchKeyword: document.getElementById('search-keyword'),
      filterProduct: document.getElementById('filter-product'),
      filterRound: document.getElementById('filter-round'),
      filterVendor: document.getElementById('filter-vendor'),
      filterStartDate: document.getElementById('filter-start-date'),
      filterEndDate: document.getElementById('filter-end-date'),
      resetFilter: document.getElementById('reset-filter-btn'),
      sortSelect: document.getElementById('sort-select'),
      exportBtn: document.getElementById('export-excel-btn'),
      statCount: document.getElementById('stat-count'),
      statQuantity: document.getElementById('stat-quantity'),
      statCost: document.getElementById('stat-cost'),
      statFee: document.getElementById('stat-fee'),
      statSale: document.getElementById('stat-sale'),
      statMargin: document.getElementById('stat-margin'),
      statMarginRate: document.getElementById('stat-margin-rate'),
      paginationInfo: document.getElementById('pagination-info'),
      paginationControls: document.getElementById('pagination-controls'),
      deleteModal: document.getElementById('delivery-delete-modal'),
      deleteName: document.getElementById('delivery-delete-name'),
      confirmDelete: document.getElementById('confirm-delivery-delete-btn'),
    };

    function loadMasterData() {
      products = productRepo.getAll();
      vendors = vendorRepo.getAll();
      rounds = roundRepo.getAll();

      // 셀렉트 옵션 채우기
      elements.productSelect.innerHTML = '<option value="">선택하세요</option>' +
        products.map(p => `<option value="${p.id}">${escapeHtml(p.name)} (${p.category})</option>`).join('');
      elements.roundSelect.innerHTML = '<option value="">선택하세요</option>' +
        rounds.map(r => `<option value="${r.id}">${escapeHtml(r.name)}</option>`).join('');
      elements.vendorSelect.innerHTML = '<option value="">선택하세요</option>' +
        vendors.map(v => `<option value="${v.id}">${escapeHtml(v.name)}</option>`).join('');

      // 필터 셀렉트
      elements.filterProduct.innerHTML = '<option value="">전체</option>' +
        products.map(p => `<option value="${p.id}">${escapeHtml(p.name)}</option>`).join('');
      elements.filterRound.innerHTML = '<option value="">전체</option>' +
        rounds.map(r => `<option value="${r.id}">${escapeHtml(r.name)}</option>`).join('');
      elements.filterVendor.innerHTML = '<option value="">전체</option>' +
        vendors.map(v => `<option value="${v.id}">${escapeHtml(v.name)}</option>`).join('');
    }

    function loadDeliveries() {
      deliveries = deliveryRepo.getAll();
      renderStats();
      renderTable();
    }

    function renderStats() {
      const filtered = getFilteredDeliveries();
      elements.statCount.textContent = filtered.length;
      elements.statQuantity.textContent = formatNumber(filtered.reduce((s, d) => s + d.quantity, 0));
      elements.statCost.textContent = formatMoney(filtered.reduce((s, d) => s + d.totalCost, 0));
      elements.statFee.textContent = formatMoney(filtered.reduce((s, d) => s + d.deliveryFee, 0));
      elements.statSale.textContent = formatMoney(filtered.reduce((s, d) => s + d.totalSalePrice, 0));
      elements.statMargin.textContent = formatMoney(filtered.reduce((s, d) => s + d.marginAmount, 0));
      const totalSale = filtered.reduce((s, d) => s + d.totalSalePrice, 0);
      const totalMargin = filtered.reduce((s, d) => s + d.marginAmount, 0);
      elements.statMarginRate.textContent = totalSale > 0 ? ((totalMargin / totalSale) * 100).toFixed(1) + '%' : '계산 불가';
    }

    function getFilteredDeliveries() {
      const keyword = elements.searchKeyword.value.toLowerCase();
      const productId = elements.filterProduct.value;
      const roundId = elements.filterRound.value;
      const vendorId = elements.filterVendor.value;
      const startDate = elements.filterStartDate.value;
      const endDate = elements.filterEndDate.value;

      return deliveries.filter((d) => {
        if (productId && d.productId !== productId) return false;
        if (roundId && d.roundId !== roundId) return false;
        if (vendorId && d.vendorId !== vendorId) return false;
        if (startDate && d.requestedAt < startDate) return false;
        if (endDate && d.requestedAt > endDate) return false;
        const matchKeyword =
          d.productName.toLowerCase().includes(keyword) ||
          d.vendorName.toLowerCase().includes(keyword);
        return matchKeyword;
      });
    }

    function renderTable() {
      const filtered = getFilteredDeliveries();
      const sortBy = elements.sortSelect.value;

      const sorted = [...filtered].sort((a, b) => {
        if (sortBy === 'latest') return new Date(b.createdAt) - new Date(a.createdAt);
        if (sortBy === 'oldest') return new Date(a.createdAt) - new Date(b.createdAt);
        if (sortBy === 'amount') return b.totalSalePrice - a.totalSalePrice;
        if (sortBy === 'quantity') return b.quantity - a.quantity;
        return 0;
      });

      // 페이지네이션
      const totalPages = Math.ceil(sorted.length / pageSize) || 1;
      if (currentPage > totalPages) currentPage = totalPages;
      const start = (currentPage - 1) * pageSize;
      const pageItems = sorted.slice(start, start + pageSize);

      elements.tableBody.innerHTML = '';

      if (pageItems.length === 0) {
        elements.emptyState.classList.remove('hidden');
        elements.tableBody.parentElement.parentElement.classList.add('hidden');
      } else {
        elements.emptyState.classList.add('hidden');
        elements.tableBody.parentElement.parentElement.classList.remove('hidden');

        pageItems.forEach((d) => {
          const tr = document.createElement('tr');
          tr.className = 'border-b border-gray-100 hover:bg-gray-50 transition-colors';
          tr.innerHTML = `
            <td class="px-6 py-3 text-sm text-gray-600">${formatDate(d.requestedAt)}</td>
            <td class="px-6 py-3 text-sm text-gray-900 font-medium">${escapeHtml(d.productName)}</td>
            <td class="px-6 py-3 text-sm text-gray-600">${escapeHtml(d.roundId ? rounds.find(r => r.id === d.roundId)?.name || '-' : '-')}</td>
            <td class="px-6 py-3 text-sm text-gray-600">${escapeHtml(d.vendorName)}</td>
            <td class="px-6 py-3 text-sm text-center text-gray-900">${formatNumber(d.quantity)}</td>
            <td class="px-6 py-3 text-sm text-right text-gray-600">${formatMoney(d.unitPrice)}</td>
            <td class="px-6 py-3 text-sm text-right text-gray-600">${formatMoney(d.totalCost)}</td>
            <td class="px-6 py-3 text-sm text-right text-gray-600">${formatMoney(d.deliveryFee)}</td>
            <td class="px-6 py-3 text-sm text-right text-gray-600">${formatMoney(d.unitSalePrice)}</td>
            <td class="px-6 py-3 text-sm text-right font-medium text-gray-900">${formatMoney(d.totalSalePrice)}</td>
            <td class="px-6 py-3 text-sm text-right font-medium ${d.marginAmount >= 0 ? 'text-green-700' : 'text-red-700'}">${formatMoney(d.marginAmount)}</td>
            <td class="px-6 py-3 text-sm text-center">
              <span class="inline-flex items-center gap-1 px-2 py-1 rounded-full text-xs font-medium ${d.marginRate === null ? 'bg-gray-100 text-gray-500' : d.marginRate >= 0 ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700'}">
                ${d.marginRate === null ? '계산 불가' : d.marginRate.toFixed(1) + '%'}
              </span>
            </td>
            <td class="px-6 py-3 text-sm text-center">
              <button onclick="editDelivery('${d.id}')" class="text-blue-600 hover:text-blue-800 text-xs font-medium" title="수정">수정</button>
              <button onclick="prepareDeleteDelivery('${d.id}', '${escapeHtml(d.productName)}')" class="text-red-600 hover:text-red-800 text-xs font-medium ml-3" title="삭제">삭제</button>
            </td>
          `;
          elements.tableBody.appendChild(tr);
        });

        renderPagination(sorted.length, totalPages);
      }
    }

    function renderPagination(totalItems, totalPages) {
      elements.paginationInfo.textContent = `${Math.min((currentPage - 1) * pageSize + 1, totalItems)} - ${Math.min(currentPage * pageSize, totalItems)} / ${totalItems} 건`;
      elements.paginationControls.innerHTML = '';

      for (let i = 1; i <= totalPages; i++) {
        const btn = document.createElement('button');
        btn.textContent = i;
        btn.className = `w-8 h-8 rounded border transition-colors ${i === currentPage ? 'bg-blue-600 text-white border-blue-600' : 'bg-white text-gray-600 border-gray-300 hover:bg-gray-100'}`;
        btn.addEventListener('click', () => {
          currentPage = i;
          renderTable();
        });
        elements.paginationControls.appendChild(btn);
      }
    }

    function openAddModal() {
      editingId = null;
      elements.title.textContent = '납품 내역 추가';
      elements.form.reset();
      elements.deliveryFeeInput.value = '0';
      elements.calcPreview.classList.add('hidden');
      clearErrors();
      elements.modal.classList.remove('hidden');
      elements.modal.setAttribute('aria-hidden', 'false');
    }

    function editDelivery(id) {
      const d = deliveries.find((x) => x.id === id);
      if (!d) return;
      editingId = id;
      elements.title.textContent = '납품 내역 수정';
      elements.idInput.value = d.id;
      elements.productSelect.value = d.productId || '';
      elements.roundSelect.value = d.roundId || '';
      elements.vendorSelect.value = d.vendorId || '';
      elements.personInput.value = d.vendorPerson || '';
      elements.phoneInput.value = d.vendorPhone || '';
      elements.requestedAtInput.value = d.requestedAt.split('T')[0];
      elements.arrivedAtInput.value = d.arrivedAt ? d.arrivedAt.split('T')[0] : '';
      elements.quantityInput.value = d.quantity;
      elements.unitPriceInput.value = d.unitPrice;
      elements.deliveryFeeInput.value = d.deliveryFee;
      elements.unitSalePriceInput.value = d.unitSalePrice;
      elements.noteInput.value = d.note || '';
      elements.calcPreview.classList.add('hidden');
      clearErrors();
      elements.modal.classList.remove('hidden');
      elements.modal.setAttribute('aria-hidden', 'false');
    }

    function closeDeliveryModal() {
      elements.modal.classList.add('hidden');
      elements.modal.setAttribute('aria-hidden', 'true');
      editingId = null;
      clearErrors();
    }

    function clearErrors() {
      ['product', 'vendor', 'requested-at', 'arrived-at', 'quantity', 'unit-price', 'delivery-fee', 'unit-sale-price'].forEach((f) => {
        const el = document.getElementById('error-' + f);
        if (el) el.classList.add('hidden');
      });
    }

    function showError(field, message) {
      const el = document.getElementById('error-' + field);
      if (el) {
        el.textContent = message;
        el.classList.remove('hidden');
      }
    }

    function autoCalculate() {
      const quantity = parseInt(elements.quantityInput.value) || 0;
      const unitPrice = parseFloat(elements.unitPriceInput.value) || 0;
      const deliveryFee = parseFloat(elements.deliveryFeeInput.value) || 0;
      const unitSalePrice = parseFloat(elements.unitSalePriceInput.value) || 0;

      if (quantity <= 0 && unitSalePrice <= 0 && unitPrice <= 0 && deliveryFee <= 0) {
        elements.calcPreview.classList.add('hidden');
        return;
      }

      const result = calculateDeliveryAmounts({ quantity, unitPrice, deliveryFee, unitSalePrice });

      elements.previewTotalCost.textContent = formatMoney(result.totalCost);
      elements.previewTotalSale.textContent = formatMoney(result.totalSalePrice);
      elements.previewMarginAmount.textContent = formatMoney(result.marginAmount);
      elements.previewMarginRate.textContent = result.marginRate !== null ? result.marginRate.toFixed(1) + '%' : '계산 불가';
      elements.calcPreview.classList.remove('hidden');
    }

    function prepareDeleteDelivery(id, name) {
      deleteTargetId = id;
      elements.deleteName.textContent = name;
      elements.deleteModal.classList.remove('hidden');
      elements.deleteModal.setAttribute('aria-hidden', 'false');
    }

    function closeDeliveryDeleteModal() {
      elements.deleteModal.classList.add('hidden');
      elements.deleteModal.setAttribute('aria-hidden', 'true');
      deleteTargetId = null;
    }

    function escapeHtml(text) {
      if (!text) return '';
      const div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }

    function formatMoneyLocal(value) {
      return new Intl.NumberFormat('ko-KR', { style: 'currency', currency: 'KRW', minimumFractionDigits: 0, maximumFractionDigits: 0 }).format(value);
    }

    // 이벤트 리스너
    elements.addBtn.addEventListener('click', openAddModal);
    elements.closeBtn.addEventListener('click', closeDeliveryModal);
    elements.resetFilter.addEventListener('click', () => {
      elements.searchKeyword.value = '';
      elements.filterProduct.value = '';
      elements.filterRound.value = '';
      elements.filterVendor.value = '';
      elements.filterStartDate.value = '';
      elements.filterEndDate.value = '';
      currentPage = 1;
      renderTable();
    });
    elements.sortSelect.addEventListener('change', () => {
      currentPage = 1;
      renderTable();
    });

    elements.vendorSelect.addEventListener('change', () => {
      const vendorId = elements.vendorSelect.value;
      const v = vendors.find((x) => x.id === vendorId);
      if (v) {
        elements.personInput.value = v.person || '';
        elements.phoneInput.value = v.phone || '';
      } else {
        elements.personInput.value = '';
        elements.phoneInput.value = '';
      }
    });

    [elements.quantityInput, elements.unitPriceInput, elements.deliveryFeeInput, elements.unitSalePriceInput].forEach((el) => {
      el.addEventListener('input', autoCalculate);
    });

    elements.form.addEventListener('submit', (e) => {
      e.preventDefault();
      clearErrors();

      const productId = elements.productSelect.value;
      const roundId = elements.roundSelect.value || undefined;
      const vendorId = elements.vendorSelect.value;
      const requestedAt = elements.requestedAtInput.value;
      const arrivedAt = elements.arrivedAtInput.value || undefined;
      const quantity = parseInt(elements.quantityInput.value);
      const unitPrice = parseFloat(elements.unitPriceInput.value) || 0;
      const deliveryFee = parseFloat(elements.deliveryFeeInput.value) || 0;
      const unitSalePrice = parseFloat(elements.unitSalePriceInput.value) || 0;
      const note = elements.noteInput.value.trim();

      let hasError = false;
      if (!productId) { showError('product', '물품을 선택해주세요.'); hasError = true; }
      if (!vendorId) { showError('vendor', '업체를 선택해주세요.'); hasError = true; }
      if (!requestedAt) { showError('requested-at', '요청일자를 선택해주세요.'); hasError = true; }
      if (!quantity || quantity <= 0) { showError('quantity', '수량은 0보다 커야 합니다.'); hasError = true; }
      if (unitPrice < 0) { showError('unit-price', '개당 원가는 0 이상이어야 합니다.'); hasError = true; }
      if (deliveryFee < 0) { showError('delivery-fee', '배송료는 0 이상이어야 합니다.'); hasError = true; }
      if (unitSalePrice < 0) { showError('unit-sale-price', '개당 단가는 0 이상이어야 합니다.'); hasError = true; }

      const product = products.find((p) => p.id === productId);
      const vendor = vendors.find((v) => v.id === vendorId);

      const calcResult = calculateDeliveryAmounts({ quantity, unitPrice, deliveryFee, unitSalePrice });

      if (hasError) return;

      const now = new Date().toISOString();
      const deliveryData = {
        productId,
        roundId,
        vendorId,
        productName: product?.name || '',
        vendorName: vendor?.name || '',
        vendorPerson: vendor?.person || '',
        vendorPhone: vendor?.phone || '',
        requestedAt,
        arrivedAt,
        quantity,
        unitPrice,
        totalCost: calcResult.totalCost,
        deliveryFee,
        unitSalePrice,
        totalSalePrice: calcResult.totalSalePrice,
        marginAmount: calcResult.marginAmount,
        marginRate: calcResult.marginRate,
        note,
      };

      if (editingId) {
        deliveryRepo.update(editingId, { ...deliveryData, updatedAt: now });
      } else {
        deliveryRepo.create(deliveryData);
      }

      closeDeliveryModal();
      loadDeliveries();
    });

    elements.confirmDelete.addEventListener('click', () => {
      if (deleteTargetId) {
        deliveryRepo.delete(deleteTargetId);
        closeDeliveryDeleteModal();
        loadDeliveries();
      }
    });

    elements.modal.addEventListener('click', (e) => {
      if (e.target === elements.modal) closeDeliveryModal();
    });
    elements.deleteModal.addEventListener('click', (e) => {
      if (e.target === elements.deleteModal) closeDeliveryDeleteModal();
    });

    window.editDelivery = editDelivery;
    window.prepareDeleteDelivery = prepareDeleteDelivery;
    window.autoCalculate = autoCalculate;

    // 초기화
    loadMasterData();
    loadDeliveries();
  </script>
</AppLayout>
