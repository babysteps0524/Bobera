---
import AppLayout from '../layouts/AppLayout.astro';
import { type StatsSummary } from '../types/index';
---

<AppLayout title="대시보드" currentPath="/">
  <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-4 mb-8">
    <!-- 전체 납품 건수 -->
    <div class="bg-white p-6 rounded-xl border border-gray-200 shadow-sm">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider">전체 납품 건수</p>
          <p class="text-3xl font-bold text-gray-900 mt-1">0</p>
        </div>
        <div class="w-10 h-10 rounded-lg bg-blue-100 flex items-center justify-center text-blue-600">
          <i class="i-ph:clipboard-list text-xl"></i>
        </div>
      </div>
    </div>

    <!-- 전체 납품 수량 -->
    <div class="bg-white p-6 rounded-xl border border-gray-200 shadow-sm">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider">전체 납품 수량</p>
          <p class="text-3xl font-bold text-gray-900 mt-1">0</p>
        </div>
        <div class="w-10 h-10 rounded-lg bg-green-100 flex items-center justify-center text-green-600">
          <i class="i-ph:boxes text-xl"></i>
        </div>
      </div>
    </div>

    <!-- 누적 매출 -->
    <div class="bg-white p-6 rounded-xl border border-gray-200 shadow-sm">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider">누적 매출</p>
          <p class="text-3xl font-bold text-gray-900 mt-1">0 원</p>
        </div>
        <div class="w-10 h-10 rounded-lg bg-purple-100 flex items-center justify-center text-purple-600">
          <i class="i-ph:currency-won text-xl"></i>
        </div>
      </div>
    </div>

    <!-- 누적 원가 -->
    <div class="bg-white p-6 rounded-xl border border-gray-200 shadow-sm">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider">누적 원가</p>
          <p class="text-3xl font-bold text-gray-900 mt-1">0 원</p>
        </div>
        <div class="w-10 h-10 rounded-lg bg-orange-100 flex items-center justify-center text-orange-600">
          <i class="i-ph:currency-won text-xl"></i>
        </div>
      </div>
    </div>

    <!-- 누적 배송료 -->
    <div class="bg-white p-6 rounded-xl border border-gray-200 shadow-sm">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider">누적 배송료</p>
          <p class="text-3xl font-bold text-gray-900 mt-1">0 원</p>
        </div>
        <div class="w-10 h-10 rounded-lg bg-pink-100 flex items-center justify-center text-pink-600">
          <i class="i-ph:truck text-xl"></i>
        </div>
      </div>
    </div>

    <!-- 누적 마진 -->
    <div class="bg-white p-6 rounded-xl border border-gray-200 shadow-sm">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider">누적 마진</p>
          <p class="text-3xl font-bold text-gray-900 mt-1">0 원</p>
        </div>
        <div class="w-10 h-10 rounded-lg bg-emerald-100 flex items-center justify-center text-emerald-600">
          <i class="i-ph:percent text-xl"></i>
        </div>
      </div>
    </div>

    <!-- 가중 평균 마진율 -->
    <div class="bg-white p-6 rounded-xl border border-gray-200 shadow-sm">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider">가중 평균 마진율</p>
          <p class="text-3xl font-bold text-gray-900 mt-1">0%</p>
        </div>
        <div class="w-10 h-10 rounded-lg bg-indigo-100 flex items-center justify-center text-indigo-600">
          <i class="i-ph:chart-pie text-xl"></i>
        </div>
      </div>
    </div>

    <!-- 등록 업체 및 물품 수 -->
    <div class="bg-white p-6 rounded-xl border border-gray-200 shadow-sm">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider">등록 업체 / 물품</p>
          <p class="text-3xl font-bold text-gray-900 mt-1">0 / 0</p>
        </div>
        <div class="w-10 h-10 rounded-lg bg-gray-100 flex items-center justify-center text-gray-600">
          <i class="i-ph:building text-xl"></i>
        </div>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- 최근 납품 내역 -->
    <div class="lg:col-span-2 bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
      <div class="p-6 border-b border-gray-200">
        <h2 class="text-lg font-bold text-gray-900 flex items-center gap-2">
          <i class="i-ph:clock text-blue-600"></i>
          최근 납품 내역
        </h2>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-left">
          <thead>
            <tr class="border-b border-gray-200">
              <th class="px-6 py-3 text-xs font-semibold text-gray-400 uppercase">일자</th>
              <th class="px-6 py-3 text-xs font-semibold text-gray-400 uppercase">물품</th>
              <th class="px-6 py-3 text-xs font-semibold text-gray-400 uppercase">업체</th>
              <th class="px-6 py-3 text-xs font-semibold text-gray-400 uppercase">수량</th>
              <th class="px-6 py-3 text-xs font-semibold text-gray-400 uppercase text-right">금액</th>
              <th class="px-6 py-3 text-xs font-semibold text-gray-400 uppercase">상태</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td colspan="6" class="px-6 py-8 text-center text-gray-400">
                등록된 납품 내역이 없습니다.
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- 빈 상태 / 요약 -->
    <div class="lg:col-span-1">
      <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden mb-6">
        <div class="p-6 border-b border-gray-200">
          <h2 class="text-lg font-bold text-gray-900 flex items-center gap-2">
            <i class="i-ph:info text-blue-600"></i>
            시스템 현황
          </h2>
        </div>
        <div class="p-6 space-y-4">
          <div class="flex items-center justify-between text-sm">
            <span class="text-gray-600">등록된 광고 물품</span>
            <span class="font-medium text-gray-900">0개</span>
          </div>
          <div class="flex items-center justify-between text-sm">
            <span class="text-gray-600">등록된 공급 업체</span>
            <span class="font-medium text-gray-900">0개</span>
          </div>
          <div class="flex items-center justify-between text-sm">
            <span class="text-gray-600">등록된 납품 차수</span>
            <span class="font-medium text-gray-900">0개</span>
          </div>
          <div class="flex items-center justify-between text-sm">
            <span class="text-gray-600">총 납품 건수</span>
            <span class="font-medium text-gray-900">0건</span>
          </div>
        </div>
      </div>

      <!-- 빠른 시작 버튼 -->
      <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6">
        <h3 class="text-sm font-semibold text-gray-900 mb-4">빠른 시작</h3>
        <div class="space-y-2">
          <a
            href="/products"
            class="w-full px-4 py-3 text-left bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-medium transition-colors flex items-center justify-between"
          >
            <span>광고 물품 등록</span>
            <i class="i-ph:arrow-right text-sm"></i>
          </a>
          <a
            href="/vendors"
            class="w-full px-4 py-3 text-left bg-green-600 hover:bg-green-700 text-white rounded-lg font-medium transition-colors flex items-center justify-between"
          >
            <span>공급 업체 등록</span>
            <i class="i-ph:arrow-right text-sm"></i>
          </a>
          <a
            href="/rounds"
            class="w-full px-4 py-3 text-left bg-purple-600 hover:bg-purple-700 text-white rounded-lg font-medium transition-colors flex items-center justify-between"
          >
            <span>납품 차수 생성</span>
            <i class="i-ph:arrow-right text-sm"></i>
          </a>
        </div>
      </div>
    </div>
  </div>
</AppLayout>
