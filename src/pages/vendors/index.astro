---
import AppLayout from '../../layouts/AppLayout.astro';
---

<AppLayout title="업체 관리" currentPath="/vendors">
  <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">업체 관리</h1>
      <p class="text-sm text-gray-500 mt-1">공급 업체를 등록·조회·수정·삭제할 수 있습니다.</p>
    </div>
    <button
      id="add-vendor-btn"
      class="inline-flex items-center gap-2 px-4 py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-medium transition-colors shadow-sm"
    >
      <i class="i-ph:plus text-sm"></i>
      <span>업체 추가</span>
    </button>
  </div>

  <!-- 검색 및 필터 -->
  <div class="bg-white p-6 rounded-xl border border-gray-200 shadow-sm mb-6">
    <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">키워드 검색</label>
        <input
          id="search-keyword"
          type="text"
          placeholder="업체명, 담당자, 연락처, 취급 품목"
          class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-colors"
        />
      </div>
      <div class="flex items-end">
        <button
          id="reset-filter-btn"
          class="px-4 py-2.5 text-gray-600 hover:text-gray-900 hover:bg-gray-100 rounded-lg transition-colors"
        >
          초기화
        </button>
      </div>
    </div>
  </div>

  <!-- 요약 카드 -->
  <div class="grid grid-cols-1 gap-4 md:grid-cols-3 mb-6">
    <div class="bg-white p-4 rounded-xl border border-gray-200 shadow-sm">
      <p class="text-xs font-semibold text-gray-400 uppercase">총 등록 업체</p>
      <p id="total-vendors" class="text-2xl font-bold text-gray-900 mt-1">0</p>
    </div>
  </div>

  <!-- 업체 목록 -->
  <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
    <div class="p-6 border-b border-gray-200">
      <h2 class="text-lg font-bold text-gray-900">업체 목록</h2>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-left">
        <thead>
          <tr class="border-b border-gray-200">
            <th class="px-6 py-3 text-xs font-semibold text-gray-400 uppercase">업체명</th>
            <th class="px-6 py-3 text-xs font-semibold text-gray-400 uppercase">담당자</th>
            <th class="px-6 py-3 text-xs font-semibold text-gray-400 uppercase">연락처</th>
            <th class="px-6 py-3 text-xs font-semibold text-gray-400 uppercase">주소</th>
            <th class="px-6 py-3 text-xs font-semibold text-gray-400 uppercase">이메일</th>
            <th class="px-6 py-3 text-xs font-semibold text-gray-400 uppercase text-right">수정일</th>
            <th class="px-6 py-3 text-xs font-semibold text-gray-400 uppercase text-center">작업</th>
          </tr>
        </thead>
        <tbody id="vendors-table-body"></tbody>
      </table>
    </div>
    <div id="empty-state" class="p-8 text-center text-gray-400 hidden">
      <p class="text-sm">등록된 업체가 없습니다.</p>
    </div>
  </div>

  <!-- 업체 추가/수정 모달 -->
  <div
    id="vendor-modal"
    class="fixed inset-0 z-50 hidden"
    aria-hidden="true"
  >
    <div class="fixed inset-0 bg-black/40 backdrop-blur-sm" onclick="closeVendorModal()"></div>
    <div class="fixed top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full max-w-md bg-white rounded-xl shadow-xl p-6 border border-gray-200">
      <div class="flex items-center justify-between mb-4">
        <h3 id="vendor-modal-title" class="text-lg font-bold text-gray-900">업체 추가</h3>
        <button
          id="close-vendor-modal-btn"
          class="p-2 rounded hover:bg-gray-100 text-gray-600 hover:text-gray-900"
          onclick="closeVendorModal()"
          aria-label="모달 닫기"
        >
          <i class="i-ph:x text-lg"></i>
        </button>
      </div>
      <form id="vendor-form" class="space-y-4">
        <input type="hidden" id="vendor-id" />
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">업체명 <span class="text-red-500">*</span></label>
          <input
            id="input-vendor-name"
            type="text"
            required
            class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none"
          />
          <p id="error-vendor-name" class="text-xs text-red-600 mt-1 hidden"></p>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">담당자 <span class="text-red-500">*</span></label>
            <input
              id="input-vendor-person"
              type="text"
              required
              class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none"
            />
            <p id="error-vendor-person" class="text-xs text-red-600 mt-1 hidden"></p>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">연락처 <span class="text-red-500">*</span></label>
            <input
              id="input-vendor-phone"
              type="text"
              required
              class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none"
            />
            <p id="error-vendor-phone" class="text-xs text-red-600 mt-1 hidden"></p>
          </div>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">위치 또는 주소</label>
          <input
            id="input-vendor-address"
            type="text"
            class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none"
          />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">이메일 (선택)</label>
          <input
            id="input-vendor-email"
            type="email"
            class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none"
          />
          <p id="error-vendor-email" class="text-xs text-red-600 mt-1 hidden"></p>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">비고</label>
          <textarea
            id="input-vendor-note"
            rows="3"
            class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none"
          ></textarea>
        </div>
        <div class="flex justify-end gap-2 pt-4">
          <button
            type="button"
            class="px-4 py-2 text-gray-600 hover:text-gray-900 hover:bg-gray-100 rounded-lg transition-colors"
            onclick="closeVendorModal()"
          >
            취소
          </button>
          <button
            type="submit"
            class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-medium transition-colors shadow-sm"
          >
            저장
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- 삭제 확인 모달 -->
  <div
    id="vendor-delete-modal"
    class="fixed inset-0 z-50 hidden"
    aria-hidden="true"
  >
    <div class="fixed inset-0 bg-black/40 backdrop-blur-sm" onclick="closeVendorDeleteModal()"></div>
    <div class="fixed top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full max-w-md bg-white rounded-xl shadow-xl p-6 border border-gray-200">
      <h3 class="text-lg font-bold text-gray-900 mb-2">업체 삭제 확인</h3>
      <p class="text-sm text-gray-600 mb-2">
        '<span id="vendor-delete-name" class="font-medium text-gray-900"></span>' 업체를 삭제하시겠습니까?
      </p>
      <p id="vendor-delete-warning" class="text-xs text-orange-600 mb-6 hidden">
        이 업체는 납품 이력이 있습니다. 삭제하면 관련 데이터에 영향을 줄 수 있습니다.
      </p>
      <div class="flex justify-end gap-2">
        <button
          type="button"
          class="px-4 py-2 text-gray-600 hover:text-gray-900 hover:bg-gray-100 rounded-lg transition-colors"
          onclick="closeVendorDeleteModal()"
        >
          취소
        </button>
        <button
          id="confirm-vendor-delete-btn"
          type="button"
          class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded-lg font-medium transition-colors shadow-sm"
        >
          삭제
        </button>
      </div>
    </div>
  </div>

  <script>
    // @ts-nocheck
    import { VendorRepository } from '../../services/repositories/index.js';
    import { formatDate } from '../../lib/utils/index.js';

    const repo = new VendorRepository();
    let vendors = [];
    let editingId = null;
    let deleteTargetId = null;

    const elements = {
      tableBody: document.getElementById('vendors-table-body'),
      emptyState: document.getElementById('empty-state'),
      modal: document.getElementById('vendor-modal'),
      addBtn: document.getElementById('add-vendor-btn'),
      closeBtn: document.getElementById('close-vendor-modal-btn'),
      form: document.getElementById('vendor-form'),
      title: document.getElementById('vendor-modal-title'),
      idInput: document.getElementById('vendor-id'),
      nameInput: document.getElementById('input-vendor-name'),
      personInput: document.getElementById('input-vendor-person'),
      phoneInput: document.getElementById('input-vendor-phone'),
      addressInput: document.getElementById('input-vendor-address'),
      emailInput: document.getElementById('input-vendor-email'),
      noteInput: document.getElementById('input-vendor-note'),
      searchKeyword: document.getElementById('search-keyword'),
      resetFilter: document.getElementById('reset-filter-btn'),
      totalCount: document.getElementById('total-vendors'),
      deleteModal: document.getElementById('vendor-delete-modal'),
      deleteName: document.getElementById('vendor-delete-name'),
      deleteWarning: document.getElementById('vendor-delete-warning'),
      confirmDelete: document.getElementById('confirm-vendor-delete-btn'),
    };

    function loadVendors() {
      vendors = repo.getAll();
      renderVendors();
    }

    function renderVendors() {
      const keyword = elements.searchKeyword.value.toLowerCase();

      const filtered = vendors.filter((v) => {
        const matchKeyword =
          v.name.toLowerCase().includes(keyword) ||
          v.person.toLowerCase().includes(keyword) ||
          v.phone.includes(keyword) ||
          (v.address || '').toLowerCase().includes(keyword);
        return matchKeyword;
      });

      elements.tableBody.innerHTML = '';

      if (filtered.length === 0) {
        elements.emptyState.classList.remove('hidden');
        elements.tableBody.parentElement.parentElement.classList.add('hidden');
      } else {
        elements.emptyState.classList.add('hidden');
        elements.tableBody.parentElement.parentElement.classList.remove('hidden');

        filtered.forEach((v) => {
          const tr = document.createElement('tr');
          tr.className = 'border-b border-gray-100 hover:bg-gray-50 transition-colors';
          tr.innerHTML = `
            <td class="px-6 py-4 text-sm font-medium text-gray-900">${escapeHtml(v.name)}</td>
            <td class="px-6 py-4 text-sm text-gray-600">${escapeHtml(v.person)}</td>
            <td class="px-6 py-4 text-sm text-gray-600">${escapeHtml(v.phone)}</td>
            <td class="px-6 py-4 text-sm text-gray-600">${escapeHtml(v.address || '-')}</td>
            <td class="px-6 py-4 text-sm text-gray-600">${escapeHtml(v.email || '-')}</td>
            <td class="px-6 py-4 text-sm text-gray-600 text-right">${formatDate(v.updatedAt)}</td>
            <td class="px-6 py-4 text-sm text-center">
              <button onclick="editVendor('${v.id}')" class="text-blue-600 hover:text-blue-800 text-sm font-medium" title="수정">
                수정
              </button>
              <button onclick="prepareDeleteVendor('${v.id}', '${escapeHtml(v.name)}')" class="text-red-600 hover:text-red-800 text-sm font-medium ml-4" title="삭제">
                삭제
              </button>
            </td>
          `;
          elements.tableBody.appendChild(tr);
        });
      }

      elements.totalCount.textContent = vendors.length;
    }

    function openAddModal() {
      editingId = null;
      elements.title.textContent = '업체 추가';
      elements.form.reset();
      clearErrors();
      elements.modal.classList.remove('hidden');
      elements.modal.setAttribute('aria-hidden', 'false');
    }

    function editVendor(id) {
      const v = vendors.find((x) => x.id === id);
      if (!v) return;
      editingId = id;
      elements.title.textContent = '업체 수정';
      elements.idInput.value = v.id;
      elements.nameInput.value = v.name;
      elements.personInput.value = v.person;
      elements.phoneInput.value = v.phone;
      elements.addressInput.value = v.address || '';
      elements.emailInput.value = v.email || '';
      elements.noteInput.value = v.note || '';
      clearErrors();
      elements.modal.classList.remove('hidden');
      elements.modal.setAttribute('aria-hidden', 'false');
    }

    function closeVendorModal() {
      elements.modal.classList.add('hidden');
      elements.modal.setAttribute('aria-hidden', 'true');
      editingId = null;
      clearErrors();
    }

    function clearErrors() {
      ['vendor-name', 'vendor-person', 'vendor-phone', 'vendor-email'].forEach((f) => {
        const el = document.getElementById('error-' + f);
        if (el) el.classList.add('hidden');
      });
    }

    function showError(field, message) {
      const el = document.getElementById('error-' + field);
      if (el) {
        el.textContent = message;
        el.classList.remove('hidden');
      }
    }

    function prepareDeleteVendor(id, name) {
      deleteTargetId = id;
      elements.deleteName.textContent = name;
      elements.deleteModal.classList.remove('hidden');
      elements.deleteModal.setAttribute('aria-hidden', 'false');
    }

    function closeVendorDeleteModal() {
      elements.deleteModal.classList.add('hidden');
      elements.deleteModal.setAttribute('aria-hidden', 'true');
      deleteTargetId = null;
    }

    function escapeHtml(text) {
      if (!text) return '';
      const div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }

    // 이벤트 리스너
    elements.addBtn.addEventListener('click', openAddModal);
    elements.closeBtn.addEventListener('click', closeVendorModal);
    elements.resetFilter.addEventListener('click', () => {
      elements.searchKeyword.value = '';
      renderVendors();
    });

    elements.form.addEventListener('submit', (e) => {
      e.preventDefault();
      clearErrors();

      const name = elements.nameInput.value.trim();
      const person = elements.personInput.value.trim();
      const phone = elements.phoneInput.value.trim();
      const address = elements.addressInput.value.trim();
      const email = elements.emailInput.value.trim();
      const note = elements.noteInput.value.trim();

      let hasError = false;
      if (!name) { showError('vendor-name', '업체명을 입력해주세요.'); hasError = true; }
      if (!person) { showError('vendor-person', '담당자를 입력해주세요.'); hasError = true; }
      if (!phone) { showError('vendor-phone', '연락처를 입력해주세요.'); hasError = true; }
      if (email && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        showError('vendor-email', '올바른 이메일 형식이 아닙니다.');
        hasError = true;
      }
      if (hasError) return;

      const now = new Date().toISOString();
      const vendorData = { name, person, phone, address, email, note };

      if (editingId) {
        repo.update(editingId, { ...vendorData, updatedAt: now });
      } else {
        repo.create(vendorData);
      }

      closeVendorModal();
      loadVendors();
    });

    elements.confirmDelete.addEventListener('click', () => {
      if (deleteTargetId) {
        repo.delete(deleteTargetId);
        closeVendorDeleteModal();
        loadVendors();
      }
    });

    elements.modal.addEventListener('click', (e) => {
      if (e.target === elements.modal) closeVendorModal();
    });
    elements.deleteModal.addEventListener('click', (e) => {
      if (e.target === elements.deleteModal) closeVendorDeleteModal();
    });

    window.editVendor = editVendor;
    window.prepareDeleteVendor = prepareDeleteVendor;

    loadVendors();
  </script>
</AppLayout>
