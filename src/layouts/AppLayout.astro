---
export interface Props {
  title?: string;
  currentPath?: string;
}

const { title = '보베라 납품 관리', currentPath = '/' } = Astro.props;

const menuItems = [
  { name: '대시보드', href: '/', icon: 'i-ph:gauge' },
  { name: '납품 내역', href: '/deliveries', icon: 'i-ph:clipboard-list' },
  { name: '광고 물품 관리', href: '/products', icon: 'i-ph:tag' },
  { name: '업체 관리', href: '/vendors', icon: 'i-ph:building' },
  { name: '납품 차수 관리', href: '/rounds', icon: 'i-ph:layers' },
  { name: '통계 및 보고서', href: '/reports', icon: 'i-ph:chart-pie' },
  { name: '백업·내보내기 및 설정', href: '/settings', icon: 'i-ph:gear' },
];
---

<!DOCTYPE html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="보베라 지역주택조합 광고 물품 납품 관리 시스템" />
    <title>{title} - 보베라 납품 관리</title>
  </head>
  <body class="bg-gray-50 text-gray-900 antialiased">
    <!-- 모바일 오버레이 -->
    <div
      id="mobile-overlay"
      class="fixed inset-0 z-40 bg-black/30 hidden md:hidden"
      onclick="document.getElementById('mobile-sidebar').classList.add('hidden'); document.getElementById('mobile-overlay').classList.add('hidden')"
    ></div>

    <!-- 상단 헤더 -->
    <header class="fixed top-0 left-0 right-0 z-50 bg-white border-b border-gray-200">
      <div class="flex items-center justify-between px-4 py-3 h-16">
        <div class="flex items-center gap-3 cursor-pointer" onclick="toggleSidebar()">
          <div class="w-8 h-8 rounded bg-blue-600 flex items-center justify-center text-white font-bold text-lg">
            보
          </div>
          <span class="font-bold text-lg hidden md:inline">보베라 납품 관리</span>
        </div>

        <div class="flex items-center gap-2 ml-auto">
          <div class="text-right hidden md:block">
            <p class="text-sm font-medium">보베라 지역주택조합</p>
            <p class="text-xs text-gray-500">광고 물품 납품 관리 시스템</p>
          </div>
          <button
            class="p-2 rounded hover:bg-gray-100 text-gray-600 hover:text-gray-900 transition-colors"
            aria-label="알림"
          >
            <span class="sr-only">알림</span>
            <i class="i-ph:bell text-lg"></i>
          </button>
          <button
            class="p-2 rounded hover:bg-gray-100 text-gray-600 hover:text-gray-900 transition-colors"
            aria-label="사용자 메뉴"
          >
            <span class="sr-only">사용자 메뉴</span>
            <i class="i-ph:user text-lg"></i>
          </button>
        </div>
      </div>
    </header>

    <!-- 데스크톱 사이드바 -->
    <aside
      class="fixed left-0 top-16 bottom-0 z-40 w-64 bg-white border-r border-gray-200 overflow-y-auto transform transition-transform duration-300"
    >
      <div class="p-4 border-b border-gray-100">
        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider">메인 메뉴</p>
      </div>
      <nav class="p-2 space-y-1">
        {menuItems.map((item) => {
          const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
          return (
            <a
              href={item.href}
              class={`px-3 py-2.5 rounded-lg text-sm font-medium transition-colors flex items-center gap-3 ${
                isActive
                  ? 'bg-blue-50 text-blue-700'
                  : 'text-gray-700 hover:bg-gray-100 hover:text-gray-900'
              }`}
            >
              <i class={item.icon} class="w-5 h-5 flex-shrink-0 text-gray-400 group-hover:text-gray-600"></i>
              <span>{item.name}</span>
            </a>
          );
        })}
      </nav>
    </aside>

    <!-- 모바일 사이드바 -->
    <aside
      id="mobile-sidebar"
      class="fixed left-0 top-16 bottom-0 z-50 w-64 bg-white border-r border-gray-200 overflow-y-auto transform -translate-x-full transition-transform duration-300"
    >
      <div class="flex items-center justify-between px-4 py-3 border-b border-gray-100">
        <p class="font-bold text-lg">보베라 납품 관리</p>
        <button
          class="p-1 rounded hover:bg-gray-100"
          onclick="document.getElementById('mobile-sidebar').classList.add('hidden'); document.getElementById('mobile-overlay').classList.add('hidden')"
        >
          <i class="i-ph:x text-xl"></i>
        </button>
      </div>
      <nav class="p-2 space-y-1">
        {menuItems.map((item) => {
          const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
          return (
            <a
              href={item.href}
              class={`px-3 py-2.5 rounded-lg text-sm font-medium transition-colors flex items-center gap-3 block ${
                isActive
                  ? 'bg-blue-50 text-blue-700'
                  : 'text-gray-700 hover:bg-gray-100 hover:text-gray-900'
              }`}
            >
              <i class={item.icon} class="w-5 h-5 flex-shrink-0 text-gray-400"></i>
              <span>{item.name}</span>
            </a>
          );
        })}
      </nav>
    </aside>

    <!-- 메인 콘텐츠 -->
    <main class="md:pl-64 pt-16 pb-8 min-h-screen">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between mb-6">
          <div>
            <h1 class="text-2xl font-bold text-gray-900">{title}</h1>
            <p class="text-sm text-gray-500 mt-1">보베라 지역주택조합 광고 물품 납품 관리</p>
          </div>
        </div>
        <slot />
      </div>
    </main>

    <script>
      function toggleSidebar() {
        const sidebar = document.getElementById('mobile-sidebar');
        const overlay = document.getElementById('mobile-overlay');
        if (sidebar && overlay) {
          if (sidebar.classList.contains('hidden')) {
            sidebar.classList.remove('hidden');
            overlay.classList.remove('hidden');
          } else {
            sidebar.classList.add('hidden');
            overlay.classList.add('hidden');
          }
        }
      }
    </script>
  </body>
</html>
